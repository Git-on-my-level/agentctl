{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentctl:schema:skill-pack-report:v1",
  "x-agentctl-docs": "../docs/managed-skills.md",
  "title": "agentctl managed skill-pack report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "healthy", "source", "manifest_sha256", "actions", "changed", "applied", "unsupported", "conflicts"],
  "properties": {
    "schema_version": { "const": 1 },
    "healthy": { "type": "boolean" },
    "source": { "$ref": "#/$defs/source" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "changed": { "type": "integer", "minimum": 0 },
    "applied": { "type": "integer", "minimum": 0 },
    "unsupported": { "type": "integer", "minimum": 0 },
    "conflicts": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_root", "remote", "commit", "manifest_path"],
      "properties": {
        "repository_root": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "manifest_path": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "harnesses", "state", "changed"],
      "properties": {
        "skill": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "harnesses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["claude", "codex", "cursor", "hermes", "omp", "multica"] }
        },
        "destination": { "type": "string", "minLength": 1 },
        "state": { "enum": ["install", "upgrade", "metadata_update", "current", "not_detected", "unsupported", "conflict", "drifted"] },
        "reason": { "type": "string", "minLength": 1 },
        "changed": { "type": "boolean" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
