{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agentctl-docs": "../docs/structured-delegation.md",
  "$id": "urn:agentctl:schema:delegate-request:v1",
  "title": "Structured delegation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_key",
    "selector"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "family"
          ]
        },
        {
          "required": [
            "model"
          ]
        }
      ],
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "effort": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        }
      }
    }
  }
}
