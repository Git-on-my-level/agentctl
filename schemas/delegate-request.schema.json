{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agentctl-docs": "../docs/structured-delegation.md",
  "$id": "urn:agentctl:schema:delegate-request:v1",
  "title": "Structured delegation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_key",
    "selector"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "family"
          ]
        },
        {
          "required": [
            "model"
          ]
        }, {"required": ["pool"]}
      ],
      "if": {"required": ["pool"]},
      "then": {"properties": {"harness": false, "family": false, "version": false, "model": false, "settings": {"properties": {"speed": false, "effort": false}}}},
      "properties": {
    "pool": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "description": "A configured capacity pool, as an alternative to family or model. Refused with harness, family, version, model, speed or effort, which the chosen candidate decides."},
        "harness": {
          "description": "Native harness constraint, including hermes (exact configured model; managed stdin, no read_only or service speed; grant-gated yolo remains constrained) and openclaw for embedded local agent turns and opencode. OpenClaw and OpenCode recipes resolve the exact configured model; OpenCode requires an exact provider/model ID, and explicit speed, effort, and read_only access are unsupported for it. OpenClaw prompt attachment preserves dash-leading message values.",
          "examples": ["openclaw"],
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "auto_compact_window": {
              "description": "Claude Code compaction window in tokens; other harnesses refuse it.",
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "effort": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "access": {
              "description": "Defaults to coding. The unattended coding grant enables reviewed coding permission recipes, including Claude Code --permission-mode auto. Claude Code read_only is refused: edit and shell-write enforcement in --print is unverified.",
              "enum": ["coding", "read_only"]
            }
          }
        }
      }
    }
  }
}
