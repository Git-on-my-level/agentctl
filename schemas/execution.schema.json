{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentctl:schema:execution:v1",
  "x-agentctl-docs": "../docs/execution-envelope.md#core-record",
  "title": "agentctl execution envelope v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "origin_host_id",
    "revision",
    "authority",
    "adapter",
    "mode",
    "acquisition",
    "state",
    "liveness",
    "source_bindings",
    "capabilities",
    "parent_execution_id",
    "supersedes",
    "superseded_by",
    "promotion",
    "created_at",
    "updated_at",
    "terminal_at",
    "observation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/execution_id"},
    "origin_host_id": {"$ref": "#/$defs/host_id"},
    "revision": {"type": "integer", "minimum": 1},
    "authority": {"enum": ["native", "multica"]},
    "adapter": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}$"
    },
    "mode": {"enum": ["direct", "multica"]},
    "acquisition": {"enum": ["launched", "attached", "promoted"]},
    "state": {
      "enum": [
        "created",
        "starting",
        "running",
        "waiting",
        "attention",
        "completed",
        "failed",
        "cancelled",
        "orphaned"
      ]
    },
    "liveness": {"enum": ["unknown", "alive", "blocked", "exited", "unreachable"]},
    "source_state": {"type": ["string", "null"], "maxLength": 512},
    "source_bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_binding"}
    },
    "capabilities": {"$ref": "#/$defs/capability_snapshot"},
    "labels": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}
    },
    "cwd": {"type": ["string", "null"]},
    "repository": {"type": ["string", "null"]},
    "workspace": {
      "anyOf": [
        {"$ref": "#/$defs/workspace_identity"},
        {"type": "null"}
      ]
    },
    "parent_execution_id": {
      "anyOf": [
        {"$ref": "#/$defs/execution_id"},
        {"type": "null"}
      ]
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/execution_id"}
    },
    "superseded_by": {
      "anyOf": [
        {"$ref": "#/$defs/execution_id"},
        {"type": "null"}
      ]
    },
    "promotion": {
      "anyOf": [
        {"$ref": "#/$defs/promotion_link"},
        {"type": "null"}
      ]
    },
    "task_contract": {
      "anyOf": [
        {"$ref": "#/$defs/task_contract"},
        {"type": "null"}
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "deadline_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "terminal_at": {"type": ["string", "null"], "format": "date-time"},
    "observation": {"$ref": "#/$defs/observation"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {"enum": ["completed", "failed", "cancelled", "orphaned"]}
        }
      },
      "then": {"properties": {"terminal_at": {"type": "string", "format": "date-time"}}},
      "else": {"properties": {"terminal_at": {"type": "null"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "multica"}}},
      "then": {"properties": {"authority": {"const": "multica"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "direct"}}},
      "then": {"properties": {"authority": {"const": "native"}}}
    }
  ],
  "$defs": {
    "execution_id": {
      "type": "string",
      "pattern": "^exec-[a-z]{3,10}(?:-[a-z]{3,10}){5}$"
    },
    "host_id": {
      "type": "string",
      "pattern": "^host-[a-z]{3,10}(?:-[a-z]{3,10}){5}$"
    },
    "source_alias_id": {
      "type": "string",
      "pattern": "^(?:source|project|issue|run)-[a-z]{3,10}(?:-[a-z]{3,10}){5}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "alias_id", "fingerprint"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "alias_id": {"$ref": "#/$defs/source_alias_id"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "opaque_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "capability_item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "status", "source"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "status": {"enum": ["supported", "degraded", "unavailable"]},
        "source": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "semantics_version": {"type": "integer", "minimum": 1},
        "constraints": {"type": "object"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "capability_snapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["negotiated_at", "adapter_version", "backend_version", "items"],
      "properties": {
        "negotiated_at": {"type": "string", "format": "date-time"},
        "adapter_version": {"type": "string", "minLength": 1},
        "backend_version": {"type": ["string", "null"]},
        "items": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability_item"}
        }
      }
    },
    "promotion_link": {
      "type": "object",
      "additionalProperties": true,
      "required": ["role", "counterpart_execution_id", "promotion_key", "state"],
      "properties": {
        "role": {"enum": ["source", "target"]},
        "counterpart_execution_id": {"$ref": "#/$defs/execution_id"},
        "promotion_key": {"$ref": "#/$defs/sha256"},
        "state": {
          "enum": [
            "planned",
            "authority_created",
            "bindings_recorded",
            "active",
            "recovery_required"
          ]
        }
      }
    },
    "task_contract": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "objective_summary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "side_effect_boundary": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "acceptance_ref": {
          "type": "string",
          "pattern": "^context-[a-z]{3,10}(?:-[a-z]{3,10}){5}$"
        },
        "expected_artifact_kinds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["same_session_required"],
          "properties": {
            "same_session_required": {"type": "boolean"}
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "portable_skill_digest": {"$ref": "#/$defs/sha256"},
            "context_digest": {"$ref": "#/$defs/sha256"},
            "handoff_digest": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "workspace_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root", "git_dir", "git_common_dir"],
      "properties": {
        "kind": {"const": "git_worktree"},
        "root": {"type": "string", "minLength": 1},
        "git_dir": {"type": "string", "minLength": 1},
        "git_common_dir": {"type": "string", "minLength": 1},
        "head_oid": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
        "head_ref": {"type": "string", "maxLength": 1024},
        "operation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["bisect", "cherry_pick", "merge", "rebase", "revert"]}
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "integrity", "observed_at", "fresh_for_seconds"],
      "properties": {
        "source": {
          "enum": [
            "durable_outbox",
            "native_stream",
            "status_api",
            "state_file",
            "poll",
            "process",
            "reconciled",
            "unknown"
          ]
        },
        "integrity": {"enum": ["verified", "degraded", "conflicted", "unknown"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "fresh_for_seconds": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
