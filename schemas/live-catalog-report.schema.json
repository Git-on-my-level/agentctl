{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentctl:schema:live-catalog-report:v1",
  "x-agentctl-docs": "../docs/configuration.md",
  "title": "agentctl live native catalog check v1",
  "description": "The live_catalog member of config doctor --live. Status unavailable also fails the command with dependency_unavailable and the doctor report at error.details.report. Availability covers this host, account and CLI version only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "checks", "limits"],
  "properties": {
    "status": {"enum": ["not_configured", "available", "partial", "unavailable"]},
    "checks": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/check"}},
    "limits": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "harness", "model", "status"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "harness": {"type": "string"},
        "model": {"type": "string"},
        "effort": {"type": "string"},
        "status": {"enum": ["available", "unavailable", "unverified"]},
        "diagnostic_code": {"enum": ["adapter_missing", "model_unavailable", "effort_unavailable", "catalog_unsupported", "catalog_probe_failed"]},
        "diagnostic": {"type": "string"}
      },
      "if": {"properties": {"status": {"const": "available"}}},
      "else": {"required": ["diagnostic_code", "diagnostic"]}
    }
  }
}
