{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agentctl-docs": "../docs/follow-up-turns.md",
  "$id": "urn:agentctl:schema:continue-result:v1",
  "title": "Continue success result payload v1",
  "description": "The result member of the normal success envelope for agentctl continue; --content emits raw answer text instead.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "continues",
    "resolved",
    "request_sha256",
    "reused",
    "continuation"
  ],
  "properties": {
    "continues": {
      "type": "string",
      "description": "The source execution: completed for carry-forward; completed, verified failed, or checkpointed parked for a supported native recovery route."
    },
    "resolved": {
      "$ref": "delegate-result.schema.json#/properties/resolved"
    },
    "requested": {
      "$ref": "delegate-result.schema.json#/properties/requested"
    },
    "provenance": {
      "$ref": "delegate-result.schema.json#/properties/provenance"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reused": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "origin_host_id": {
      "type": "string"
    },
    "state": {
      "$ref": "execution.schema.json#/properties/state"
    },
    "liveness": {
      "$ref": "execution.schema.json#/properties/liveness"
    },
    "authority": {
      "const": "native"
    },
    "plan": {
      "const": true
    },
    "side_effect_class": {
      "const": "read_only"
    },
    "lifecycle": {
      "type": "object"
    },
    "native": {
      "type": "object",
      "description": "Plan only. The native session id in argv is replaced by <native-session>. Devin ACP uses the internal --agentctl-acp-session descriptor, stripped before exec and mapped to session/load only when loadSession is advertised. --agentctl-acp-config descriptors stay on the argv, so the loaded session is verified again."
    },
    "outcome": {
      "$ref": "outcome.schema.json"
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "native_session_reused"
      ],
      "properties": {
        "mode": {
          "enum": [
            "native",
            "carry_forward"
          ]
        },
        "native_session_reused": {
          "type": "boolean"
        },
        "prior_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "sha256",
            "bytes"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "native"
            },
            "native_session_reused": {
              "const": true
            }
          },
          "not": {
            "required": [
              "prior_result"
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "carry_forward"
            },
            "native_session_reused": {
              "const": false
            }
          },
          "required": [
            "prior_result"
          ]
        }
      ]
    },
    "replayed": {
      "const": true,
      "description": "Existing FAILED/CANCELLED work recovered by request key. No relaunch; next_actions explains a deliberate retry with a new key."
    }
  },
  "anyOf": [
    {
      "required": [
        "plan",
        "side_effect_class",
        "lifecycle"
      ]
    },
    {
      "required": [
        "id",
        "origin_host_id",
        "state",
        "liveness",
        "authority",
        "requested",
        "provenance"
      ]
    }
  ]
}
