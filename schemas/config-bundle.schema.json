{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentctl:schema:config-bundle:v1",
  "title": "agentctl explicit local configuration bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": { "const": 1 },
    "default_profile": { "type": "string", "minLength": 1 },
    "skills": { "$ref": "#/$defs/skills" },
    "anx": { "$ref": "#/$defs/anx" },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "capacity": {"type": "object", "additionalProperties": false, "properties": {"file": {"type": "string", "pattern": "^/", "description": "Absolute path of the capacity facts file."}, "max_age_seconds": {"type": "integer", "minimum": 0, "description": "Facts older than this are stale. Default 3600."}, "switch_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Used ratio at which a candidate stops receiving new work. Default 0.95."}, "launch_debit": {"type": "number", "minimum": 0, "maximum": 1, "description": "Used ratio one recent launch is assumed to cost when balancing. Default 0.02."}, "pools": {"type": "object", "maxProperties": 32, "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "additionalProperties": {"$ref": "#/$defs/capacity_pool"}}}},
    "capacity_pool": {"type": "object", "additionalProperties": false, "required": ["candidates"], "properties": {"mode": {"enum": ["priority", "balance"]}, "candidates": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/capacity_candidate"}}}},
    "capacity_candidate": {"type": "object", "additionalProperties": false, "required": ["harness", "model", "account"], "properties": {"harness": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "effort": {"type": "string"}, "account": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "executable": {"type": "string", "pattern": "^/", "description": "Launcher for this account. Absent uses the harness adapter's executable."}, "switch_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "cutoff_exempt": {"type": "boolean", "description": "Never cut off by usage, for accounts meant to run past their allowance."}, "windows": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1}, "description": "Window names that limit this candidate. Absent means all."}}},
    "anx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_links": {
          "type": "object",
          "additionalProperties": false,
          "description": "Advisory Agent Nexus run-link registration. agentctl reads no ANX credentials; the reviewed anx CLI owns authentication and workspace resolution.",
          "properties": {
            "default": { "enum": ["labeled", "all", "off"] },
            "workspace_alias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
            "allowed_orgs": {
              "type": "array", "maxItems": 64,
              "items": {"type": "string", "minLength": 1},
              "description": "Optional owner restriction for origin repository metadata and typed evidence. Empty (default) allows any owner; non-empty requires a matching owner. PR/issue evidence must match the run origin. Never authorizes parsing result text."
            },
            "executable": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "base_url": { "type": "string", "format": "uri", "description": "HTTPS, or HTTP on an explicit loopback host. Never hard-coded; passed through to the anx CLI." },
            "config_dir": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "spool_dir": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "flush_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "update_policy"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["remote", "manifest_path"],
          "properties": {
            "remote": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 },
            "manifest_path": { "type": "string", "minLength": 1 }
          }
        },
        "update_policy": { "enum": ["manual", "auto-clean"] }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
    "capacity": {"$ref": "#/$defs/capacity"},
        "adapters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/adapter" }
        },
        "multica": { "$ref": "#/$defs/multica" },
        "agent_preferences": { "$ref": "#/$defs/agent_preferences" },
        "route": { "$ref": "#/$defs/route" },
        "delegation": { "$ref": "#/$defs/delegation" }
      },
      "anyOf": [
        { "required": ["adapters"] }, {"required": ["capacity"]},
        { "required": ["multica"] },
        { "required": ["agent_preferences"] },
        { "required": ["route"] }
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "executable": { "type": "string", "minLength": 1, "description": "Exact native executable. Without an explicit adapter, run and fanout match configured exact/resolved paths before basenames; equal-strength cross-harness matches are ambiguous." }
      }
    },
    "agent_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "preferred"],
      "properties": {
        "mode": { "const": "advisory" },
        "preferred": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agent_preference" }
        },
        "notes": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "agent_preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "model"],
      "properties": {
        "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "speed": { "type": "string", "minLength": 1, "maxLength": 128 },
        "use_for": { "type": "string", "maxLength": 128 },
        "family": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "effort": { "type": "string", "minLength": 1, "maxLength": 128 },
        "default": { "type": "boolean" }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor_workspace_trust": {"description": "Required grant for Cursor read_only delegation; when granted all Cursor recipes add --trust.", "type": "boolean" },
        "unattended_coding_permissions": { "type": "boolean", "description": "Explicit grant for coding delegates: Cursor --force, Codex --dangerously-bypass-approvals-and-sandbox, Claude Code --permission-mode auto, and Devin ACP one-operation permission approvals. Never applied to read_only or expert run argv." }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "this_host": { "type": "string", "maxLength": 128 },
        "hosts": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },
    "multica": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "profile", "workspace_id", "server_url", "app_url"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "workspace_id": { "type": "string", "minLength": 1 },
        "server_url": { "type": "string", "format": "uri", "description": "HTTPS, or HTTP on an explicit loopback host" },
        "app_url": { "type": "string", "format": "uri", "description": "HTTPS, or HTTP on an explicit loopback host" }
      }
    }
  }
}
