{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentctl:schema:anx-registration:v4",
  "x-agentctl-docs": "../docs/design/anx-run-links.md#redaction-and-egress",
  "title": "Authoritatively verified ANX run registration v4",
  "description": "Generated/catalog metadata and credential-checked journal working directory in the outbox. Delivery enriches confirmed canonical ANX card refs, local origin host/owner/name, and explicit typed evidence after optional owner restrictions. No field is derived from result prose or JSON lines. Remote URL userinfo is stripped before parsing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "launcher",
    "external_id",
    "origin_host_id",
    "durable_id",
    "adapter",
    "model",
    "state",
    "liveness",
    "result_collected",
    "sequence",
    "built_at"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "phase": {
      "enum": [
        "start",
        "terminal"
      ]
    },
    "launcher": {
      "const": "agentctl"
    },
    "external_id": {
      "$ref": "execution.schema.json#/$defs/execution_id"
    },
    "origin_host_id": {
      "$ref": "execution.schema.json#/$defs/host_id"
    },
    "durable_id": {
      "type": "string",
      "pattern": "^agentctl://host-(?:[a-z]+-){5}[a-z]+/exec-(?:[a-z]+-){5}[a-z]+$",
      "description": "Runtime additionally validates word dictionary, type-bound checksums, and equality with the two ID fields."
    },
    "request_key_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "adapter": {
      "enum": [
        "claude-code",
        "codex",
        "cursor",
        "omp",
        "openclaw",
        "opencode",
        "hermes",
        "zcode",
        "devin",
        "generic-process",
        "multica",
        "other"
      ]
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./_\\[\\]=,-]{0,127}$",
      "description": "Exact reviewed profile catalog membership for this adapter, else other."
    },
    "state": {
      "enum": [
        "starting",
        "running",
        "completed",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "liveness": {
      "enum": [
        "alive",
        "stale",
        "unknown"
      ]
    },
    "card_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^card:[a-z0-9][a-z0-9-]{0,63}$",
        "description": "Delivery-only canonical ref from the target workspace cards.list response. Unverified refs never enter the outbox."
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "result_collected": {
      "type": "boolean"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability"
      ],
      "properties": {
        "availability": {
          "enum": [
            "stored",
            "omitted_by_policy",
            "unavailable_at_source"
          ]
        },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "retryable"
          ],
          "properties": {
            "code": {
              "const": "execution_failed"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        },
        "links": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "owner",
                  "repo",
                  "number"
                ],
                "properties": {
                  "kind": {
                    "const": "pr"
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Well-formed remote path component with per-token credential checks."
                  },
                  "repo": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Well-formed remote path component with per-token credential checks."
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "owner",
                  "repo",
                  "number"
                ],
                "properties": {
                  "kind": {
                    "const": "issue"
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Well-formed remote path component with per-token credential checks."
                  },
                  "repo": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Well-formed remote path component with per-token credential checks."
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "sha"
                ],
                "properties": {
                  "kind": {
                    "const": "commit"
                  },
                  "sha": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  }
                }
              }
            ]
          },
          "description": "Explicit typed evidence only. PRs/issues require exact run-origin owner/repo and an allowed owner when allowed_orgs is non-empty. Origin host is in repository.host; commits are 40-hex."
        },
        "head_after": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "native_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "kind",
        "fingerprint"
      ],
      "properties": {
        "provider": {
          "enum": [
            "claude",
            "codex",
            "cursor",
            "omp",
            "openclaw",
            "opencode",
            "hermes",
            "zcode",
            "devin",
            "generic-process",
            "multica"
          ]
        },
        "kind": {
          "const": "provider_session_sha256"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "supersedes_external_id": {
      "$ref": "execution.schema.json#/$defs/execution_id"
    },
    "egress_error_code": {
      "enum": [
        1001,
        1002,
        1003,
        1004
      ],
      "description": "egress_rejected: secret shape, length, format, or unverified authority; never includes the value."
    },
    "cwd": {
      "type": "string",
      "description": "Run working directory; credential-shaped fields are omitted."
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Run CWD origin, parsed after stripping userinfo. Any remote host is permitted. Credential-shaped components are omitted independently."
    }
  }
}
