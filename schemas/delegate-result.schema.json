{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agentctl-docs": "../docs/structured-delegation.md",
  "$id": "urn:agentctl:schema:delegate-result:v1",
  "title": "Delegate success result payload v1",
  "description": "The result member of the normal success envelope; --content emits raw answer text instead. Detached admission returns this same receipt after launch, without asserting completion or acknowledging collection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requested",
    "resolved",
    "provenance",
    "request_sha256",
    "reused"
  ],
  "properties": {
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "family"
          ]
        },
        {
          "required": [
            "model"
          ]
        }
      ],
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "effort": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "access": {
              "enum": [
                "coding",
                "read_only"
              ]
            }
          }
        }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "model",
        "host",
        "authority",
        "settings"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "authority": {
          "enum": [
            "native",
            "multica"
          ]
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "effort": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "access": {
              "enum": [
                "coding",
                "read_only"
              ]
            }
          }
        }
      }
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reused": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_sha256",
        "defaulted"
      ],
      "properties": {
        "configuration_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "defaulted": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "harness",
              "family",
              "version",
              "model",
              "host",
              "settings.speed",
              "settings.effort",
              "speed",
              "effort",
              "settings.access"
            ]
          }
        }
      }
    },
    "id": {
      "type": "string"
    },
    "origin_host_id": {
      "type": "string"
    },
    "state": {
      "$ref": "execution.schema.json#/properties/state"
    },
    "liveness": {
      "$ref": "execution.schema.json#/properties/liveness"
    },
    "authority": {
      "enum": [
        "native",
        "multica"
      ]
    },
    "plan": {
      "const": true
    },
    "side_effect_class": {
      "const": "read_only"
    },
    "lifecycle": {
      "type": "object",
      "description": "Plans describe prospective ownership. A new detached receipt includes owner=detached_process, parent_independent=true, reboot_recovery=false. A replay makes no ownership migration claim.",
      "properties": {
        "owner": {
          "enum": [
            "foreground_process",
            "detached_process"
          ]
        },
        "parent_independent": {
          "type": "boolean"
        },
        "reboot_recovery": {
          "const": false
        }
      }
    },
    "native": {
      "type": "object",
      "description": "Native launch plan. Devin uses ACP stdio; permission handling is controlled by the explicit AGENTCTL_DEVIN_ACP_APPROVE environment entry, never ambient values.",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Prompt-free argv; Devin starts acp --model <configured-model>."
        },
        "env": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Reviewed non-secret launch environment. Devin ACP uses AGENTCTL_DEVIN_ACP_APPROVE=0 or =1 from the coding grant."
        },
        "prompt_delivery": {
          "enum": [
            "argv",
            "stdin",
            "stream"
          ],
          "description": "Devin ACP requires a nonempty valid UTF-8 prompt through managed stdin, validated before probing, admission, or launch. Plans reject missing prompt evidence or argv/stream delivery. The adapter encodes the unchanged text in session/prompt."
        },
        "permissions": {
          "description": "Reviewed permission recipe, not provider attestation. Claude Code coding is constrained: the unattended coding grant adds --permission-mode auto, which retains classifier checks and can deny tool calls; without the grant no permission flag is added. Claude Code read_only is refused.",
          "enum": [
            "full",
            "constrained",
            "read_only",
            "unsupported"
          ]
        }
      }
    },
    "outcome": {
      "$ref": "outcome.schema.json"
    },
    "replayed": {
      "const": true,
      "description": "Existing FAILED/CANCELLED work recovered by request key, without relaunch. Also present at error.details.replayed on --wait errors."
    }
  },
  "anyOf": [
    {
      "required": [
        "plan",
        "side_effect_class"
      ]
    },
    {
      "required": [
        "id",
        "origin_host_id",
        "state",
        "liveness",
        "authority"
      ]
    }
  ]
}
