{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentctl:schema:fanout-manifest:v1",
  "x-agentctl-docs": "../README.md",
  "title": "agentctl foreground fan-out manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt_file", "children"],
  "properties": {
    "schema_version": { "const": 1 },
    "prompt_file": { "type": "string", "minLength": 1 },
    "prompt_delivery": { "enum": ["argv", "stdin"] },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/child" }
    }
  },
  "$defs": {
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "execution_id": { "type": "string", "pattern": "^exec-(?:[a-z]+-){5}[a-z]+$" },
        "adapter": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "timeout": { "type": "string", "minLength": 1 },
        "prompt_delivery": { "enum": ["argv", "stdin"] },
        "no_store_result": { "type": "boolean" },
        "allow_missing_result": { "type": "boolean" },
        "allow_unreliable_result": { "type": "boolean" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "type": "string" }
        }
      }
    }
  }
}
