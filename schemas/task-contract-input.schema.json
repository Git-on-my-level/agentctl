{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentctl:schema:task-contract-input:v1",
  "x-agentctl-docs": "../docs/execution-envelope.md#task-contract-metadata",
  "title": "agentctl direct run task-contract input v1",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "objective_summary": {"type": "string", "minLength": 1, "maxLength": 2048},
    "side_effect_boundary": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "acceptance_ref": {
      "type": "string",
      "pattern": "^context-[a-z]{3,10}(?:-[a-z]{3,10}){5}$"
    },
    "expected_artifact_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_session_required"],
      "properties": {
        "same_session_required": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "portable_skill_digest": {"$ref": "#/$defs/sha256"},
        "context_digest": {"$ref": "#/$defs/sha256"},
        "handoff_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
