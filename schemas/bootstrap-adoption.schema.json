{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentctl:schema:bootstrap-adoption:v1",
  "x-agentctl-docs": "../docs/upgrade-reliability.md",
  "title": "Explicit legacy portable skill adoption result",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "state", "digest", "published_releases", "dry_run"],
  "properties": {
    "path": {"type": "string", "minLength": 1},
    "state": {"enum": ["planned", "adopted"]},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "published_releases": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"}},
    "backup": {"type": "string", "minLength": 1},
    "dry_run": {"type": "boolean"}
  }
}
